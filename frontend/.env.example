# Copy to .env (git-ignored) and fill in from your Supabase project:
# Project Settings -> API -> Project URL / anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The harbory-control-plane HTTP API (see crates/control-plane/src/main.rs
# HTTP_LISTEN_ADDR, default 127.0.0.1:8080).
VITE_API_URL=http://localhost:8080
